{
  "name": "navora-claude-plugin",
  "version": "0.1.0",
  "description": "Claude Code MCP plugin for AI Browser Runtime — control Chrome from Claude",
  "type": "module",
  "bin": {
    "ai-browser-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@ai-browser-runtime/browser-tools": "workspace:*",
    "@ai-browser-runtime/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude",
    "mcp",
    "browser",
    "automation",
    "ai"
  ]
}
