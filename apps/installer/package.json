{
  "name": "navora",
  "version": "0.1.0",
  "description": "Instalador TUI para Navora AI Browser Runtime (Claude Code, Cursor, verificación)",
  "type": "module",
  "bin": {
    "navora": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["navora", "mcp", "browser", "cursor", "claude", "installer"],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
