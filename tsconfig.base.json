{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ai-browser-runtime/protocol": ["packages/protocol/src"],
      "@ai-browser-runtime/shared": ["packages/shared/src"],
      "@ai-browser-runtime/browser-tools": ["packages/browser-tools/src"],
      "@ai-browser-runtime/mcp": ["packages/mcp/src"],
      "@ai-browser-runtime/ui": ["packages/ui/src"],
      "@ai-browser-runtime/daemon": ["apps/daemon/src"],
      "@ai-browser-runtime/extension": ["apps/extension/src"],
      "@ai-browser-runtime/claude-plugin": ["apps/claude-plugin/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".turbo"]
}